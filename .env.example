# .env.example — gvc-docker
# Copiar para .env e preencher. NUNCA commitar o .env.

DB_NAME=gvc
DB_USER=gvc_admin
DB_PASSWORD=GERAR_SENHA_FORTE_AQUI_MIN_24_CHARS
# DB_PORT=5432   # só para debug local; não usar em produção

JWT_SECRET=GERAR_CHAVE_ALEATORIA_MIN_64_CHARS_openssl_rand_hex_32
JWT_EXPIRES_IN=8h

API_PORT=3001
FRONTEND_PORT=3000
CORS_ORIGIN=https://seu-dominio.gov.br
NODE_ENV=production

BRASIL_API_URL=https://brasilapi.com.br/api/cpf/v1
SENTRY_DSN=

# ==========================================
# E-MAIL (Zimbra FEM)
# ==========================================
SMTP_HOST=smtp.ac.gov.br
SMTP_PORT=587
SMTP_USER=SEU_EMAIL_NO_ZIMBRA@ac.gov.br
SMTP_PASS=SUA_SENHA_DO_ZIMBRA
SMTP_SECURE=false
SMTP_SENDER_NAME=Sistema GVC - Gestão de Visitantes Culturais
